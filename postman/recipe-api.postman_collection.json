{
  "info": {
    "name": "Recipe Sharing API",
    "description": "Spring Boot midterm API. Start the app, then run folders 1, 2, 3, 5, 6 in order (the Runner does this). Folder 4 needs a file picked by hand.\n\nVariable baseUrl defaults to http://localhost:8080.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "chefId",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "tagId",
      "value": ""
    },
    {
      "key": "recipeId",
      "value": ""
    },
    {
      "key": "imageRecipeId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Setup (run first)",
      "description": "Creates a chef, category and tag and stores their ids in collection variables.",
      "item": [
        {
          "name": "Create chef",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"chefId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/chefs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "chefs"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Chef\",\n  \"email\": \"postman.{{$timestamp}}@test.com\",\n  \"bio\": \"Created from Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Create category",
          "event": [
            {
              "listen": "test",
